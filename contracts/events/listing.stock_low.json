{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "listing.stock_low",
  "title": "listing.stock_low",
  "description": "Producer: catalog. A reservation took a listing's stock from above its low-stock line (10 kg, 1 quintal, 3 dozen, 10 pieces, bunches or litres) to at or below it. Same payload as listing.updated plus `soldOut`, true when nothing is left (the listing is then SOLD_OUT until stock returns). Sent once per crossing.",
  "type": "object",
  "required": [
    "listingId",
    "farmId",
    "farmerId",
    "cropId",
    "cropName",
    "qtyAvailable",
    "unit",
    "pricePerUnit",
    "status",
    "pickupLocation",
    "soldOut"
  ],
  "properties": {
    "listingId": {
      "type": "string",
      "format": "uuid"
    },
    "farmId": {
      "type": "string",
      "format": "uuid"
    },
    "farmerId": {
      "type": "string",
      "format": "uuid"
    },
    "cropId": {
      "type": "string",
      "examples": [
        "tomato"
      ]
    },
    "cropName": {
      "type": "string"
    },
    "variety": {
      "type": [
        "string",
        "null"
      ]
    },
    "qtyAvailable": {
      "type": "number",
      "minimum": 0
    },
    "unit": {
      "enum": [
        "kg",
        "quintal",
        "dozen",
        "piece",
        "bunch",
        "litre"
      ]
    },
    "pricePerUnit": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "grade": {
      "enum": [
        "A",
        "B",
        "C",
        null
      ]
    },
    "isOrganic": {
      "type": "boolean"
    },
    "status": {
      "enum": [
        "ACTIVE",
        "PAUSED",
        "SOLD_OUT",
        "ARCHIVED"
      ]
    },
    "pickupLocation": {
      "type": "object",
      "description": "GeoJSON Point, coordinates [lng, lat]",
      "required": [
        "type",
        "coordinates"
      ],
      "properties": {
        "type": {
          "const": "Point"
        },
        "coordinates": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "mediaIds": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      }
    },
    "soldOut": {
      "type": "boolean"
    }
  }
}
