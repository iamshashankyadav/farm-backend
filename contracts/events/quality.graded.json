{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quality.graded",
  "title": "quality.graded",
  "description": "Producer: quality. A report was submitted for an order or harvest inspection.",
  "type": "object",
  "required": ["inspectionId", "subjectType", "subjectId", "attempt", "grade", "result"],
  "properties": {
    "inspectionId": { "type": "string", "format": "uuid" },
    "subjectType": { "enum": ["ORDER", "HARVEST"] },
    "subjectId": { "type": "string", "format": "uuid" },
    "attempt": { "type": "integer", "minimum": 1 },
    "grade": { "enum": ["A", "B", "C"] },
    "result": { "enum": ["PASS", "FAIL"] },
    "resolution": { "enum": ["REHARVEST", "ACCEPT_LOWER_GRADE", null] },
    "weightKg": { "type": "number", "exclusiveMinimum": 0 },
    "moisturePct": { "type": "number", "minimum": 0, "maximum": 100 },
    "pestFound": { "type": "boolean" },
    "mediaIds": { "type": "array", "items": { "type": "string", "format": "uuid" } }
  },
  "additionalProperties": true
}